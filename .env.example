VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_BASE_URL=https://firstaid.morroo.com
SUPABASE_SERVICE_ROLE_KEY=
VITE_META_PIXEL_ID=1524889459310260
# LINE admin alert when a theory certificate is issued (LINE Official Account, Messaging API).
# Leave blank to disable — issuance still works without it.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
# LINE Login (ผู้เรียนสมัคร/ล็อกอินด้วย LINE) — คนละ channel กับ Messaging API ด้านบน
# สร้าง "LINE Login channel" ใน LINE Developers, ผูก OA @jiacpr, เปิด Add friend option (aggressive),
# ตั้ง callback URL = <base>/auth/line/callback. เว้นว่าง = ปิดล็อกอิน (แอป fallback honor-system)
VITE_LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# LINE nurture (Phase 5): channel secret of the SAME Messaging API channel, used to
# verify the opt-out webhook signature (api/line/webhook.js). Different from
# LINE_LOGIN_CHANNEL_SECRET (LINE Login). Leave blank to disable signature checks.
LINE_CHANNEL_SECRET=
# Shared secret guarding cron endpoints (api/ad-report, api/nurture/run).
CRON_SECRET=
# อีเมลแอดมิน (คั่นด้วย ,) — จำเป็นสำหรับ API ฝั่งแอดมิน (vouchers, ใบเซอร์ปฏิบัติ, สื่อบทเรียน)
# token ที่ valid อย่างเดียวไม่พอ เพราะผู้เรียนที่ล็อกอิน LINE ทุกคนก็มี Supabase token
# เว้นว่าง = ปฏิเสธทุกคน (ยกเว้น user ที่มี app_metadata.role = 'admin')
ADMIN_EMAILS=
# PostHog analytics (optional — omit to disable frontend tracking)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
