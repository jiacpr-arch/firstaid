VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_BASE_URL=https://firstaid.morroo.com
SUPABASE_SERVICE_ROLE_KEY=
VITE_META_PIXEL_ID=1524889459310260
# LINE admin alert when a theory certificate is issued (LINE Official Account, Messaging API).
# Leave blank to disable — issuance still works without it.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
# LINE nurture (Phase 5): channel secret of the SAME Messaging API channel, used to
# verify the opt-out webhook signature (api/line/webhook.js). Different from
# LINE_LOGIN_CHANNEL_SECRET (LINE Login). Leave blank to disable signature checks.
LINE_CHANNEL_SECRET=
# Shared secret guarding cron endpoints (api/ad-report, api/nurture/run).
CRON_SECRET=
# PostHog analytics (optional — omit to disable frontend tracking)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
